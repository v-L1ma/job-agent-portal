# ---------------------------------------------------------------
# job-agent-portal — variáveis de ambiente (exemplo)
# Copie para `.env.local` (dev) ou configure no host (produção).
# ---------------------------------------------------------------

# NextAuth v4 — obrigatório
# Segredo usado para assinar sessões/JWT. Gere com: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# URL pública da aplicação (usada pelo NextAuth para callbacks/redirects)
# Dev: http://localhost:3000
NEXTAUTH_URL=

# URL base da API Go (go-job-agent-api) — obrigatório
# Dev: http://localhost:1323/api/v1
NEXT_PUBLIC_API_URL=

# Google OAuth (login com Google) — obrigatório para o provider Google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe — chave publishable (PUBLIC)
# Sem esta variável o checkout é bloqueado com erro explícito em tela.
# NÃO deixe chaves de teste hardcoded no código.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------

# Mesma URL da API porém apenas para o servidor (fallback: NEXT_PUBLIC_API_URL)
# API_URL=

# Segredo do NextAuth com outro nome aceito pelo NextAuth (fallback: NEXTAUTH_SECRET)
# AUTH_SECRET=

# Base URL usada pelo SEO/metadados (fallback: https://buscavagas.com.br)
# NEXT_PUBLIC_APP_URL=
